<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/connectionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/waiting"
            android:textColor="@color/warning"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:maxLines="1"
            android:text="@string/mode_unknown"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/telemetryText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/ready_unknown"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/cameraStatsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/camera_connecting"
            android:textColor="@color/accent"
            android:textSize="10sp" />

        <Button
            android:id="@+id/toolsButton"
            android:layout_width="58dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:text="@string/tools"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/safetyText"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/safety_hint"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.osrbot.open32drone.controller.JoystickView
            android:id="@+id/leftJoystick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/left_stick" />

        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="135dp"
                android:background="@drawable/panel">

                <ImageView
                    android:id="@+id/cameraPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/camera_title"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/flightActionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/panel"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/position_only"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/takeoffHeight"
                        android:layout_width="70dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:hint="@string/height_hint"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:selectAllOnFocus="true"
                        android:text="@string/default_takeoff_height"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/disarmButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:paddingHorizontal="1dp"
                        android:text="@string/disarm"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/takeoffButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:paddingHorizontal="1dp"
                        android:text="@string/takeoff"
                        android:textSize="8sp" />

                    <Button
                        android:id="@+id/landButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:paddingHorizontal="1dp"
                        android:text="@string/land"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.osrbot.open32drone.controller.JoystickView
            android:id="@+id/rightJoystick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/right_stick" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
